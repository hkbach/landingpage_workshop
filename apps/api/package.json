{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.4.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^5.0.5"
  }
}
