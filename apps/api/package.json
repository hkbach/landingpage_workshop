{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "dev:worker": "node --watch --import tsx src/main.worker.ts",
    "build": "node build.mjs",
    "start": "node dist/main.js",
    "start:worker": "node dist/main.worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --import tsx src/db/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@workshop/shared": "workspace:*",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.4.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.16.0",
    "pg-boss": "^12.38.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^5.0.5"
  }
}
